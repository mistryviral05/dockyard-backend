# ---------------------------------------------------------------- deployments

@projectId=project_ic6yp2s1i2pqvbozr3oiml6sld31wh9z
@deploymentId=deployment_REPLACE_ME

### deploy the project's default branch (body may be omitted entirely)
POST {{base}}/projects/{{projectId}}/deploy
Content-Type: application/json
Authorization: Bearer {{token}}

{}



### list deployments, newest first
GET {{base}}/projects/{{projectId}}/deployments
Content-Type: application/json
Authorization: Bearer {{token}}

### list with paging - cursor is the id of the last row of the previous page
GET {{base}}/projects/{{projectId}}/deployments?limit=5
Content-Type: application/json
Authorization: Bearer {{token}}

###
GET {{base}}/projects/{{projectId}}/deployments?limit=5&cursor={{deploymentId}}
Content-Type: application/json
Authorization: Bearer {{token}}

### single deployment
GET {{base}}/deployments/{{deploymentId}}
Content-Type: application/json
Authorization: Bearer {{token}}

### 404 - unknown deployment
GET {{base}}/deployments/deployment_doesnotexist000000000
Content-Type: application/json
Authorization: Bearer {{token}}

